# Python
__pycache__/
*.pyc
.venv/
*/.venv/
.matplotlib-cache/
.DS_Store

# Unified results tree (results/<method>/...): ignore by default; track lightweight
# artifacts (metrics, logs, configs, figures, comparison plots). Checkpoints (*.pt)
# stay ignored globally — use scripts/git_add_results.sh to force-add under 50MB.
results/**
!results/**/
!results/**/metrics.json
!results/**/metrics_*.json
!results/**/config.yaml
!results/**/train_log.csv
!results/**/logs/
!results/**/logs/**
!results/**/predictions*.csv
!results/**/figures/
!results/**/figures/**
!results/comparison/
!results/comparison/**

# Local demo / paper assets
*.pdf
RAISE_1k.csv
/test*.png
data/RAISE_1k.csv

# Pilot run logs (keep PILOT_SUMMARY.md only)
data/pilot_results/*.log

# Data caches (track index + pilot summaries only; see data/.gitignore)
data/raise_png/
data/generated/
data/images_png/
data/images_tif/
data/protocol_dataset/
data/raise_raw/tiff/
data/raise_raw/*.tif
data/raise_raw/*.TIF
*/data/
outputs/
logs/
checkpoints/
runs/

# Re-allow results/ subpaths overridden by logs/, checkpoints/, *.pt above
!results/**/logs/
!results/**/logs/**
!results/**/checkpoints/
!results/**/checkpoints/*.pt

# CNN: no vendored deps or large zips in git
CNN/spectral-history-cnn/.pydeps_npu/

# Keep lightweight CNN experiment summaries tracked.
!CNN/
!CNN/spectral-history-cnn/
!CNN/spectral-history-cnn/outputs/v1_final64_poscnn/
!CNN/spectral-history-cnn/outputs/v1_final64_poscnn/**
# Ignore duplicate flat outputs/ copies (canonical: outputs/v1_final64_poscnn/)
CNN/spectral-history-cnn/outputs/metrics.json
CNN/spectral-history-cnn/outputs/metrics_test.json
CNN/spectral-history-cnn/outputs/predictions_test.csv
CNN/spectral-history-cnn/outputs/train_log.csv
CNN/spectral-history-cnn/fusion_result.json

# ML large files
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
!results/**/checkpoints/*.pt

# Archives
*.tar.gz
*.zip

# Classical detector test artifacts (CSV summaries only)
test_images/
test_results/raise_tiff_downloads*/
test_results/**/references/
test_results/**/controlled_sources/
test_results/**/cases/
test_results/**/*.png
test_results/**/*.tif
test_results/**/*.tiff
test_results/controlled_resampling_raise1_sample/

# Spectral mask: clean-run summaries only
spectral-mask-resampling/data/
spectral-mask-resampling/outputs/
spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask/
spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_fast/
spectral-mask-resampling/outputs/debug_v1/
spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_heldout_size/
spectral-mask-resampling/.venv/
spectral-mask-resampling/.matplotlib-cache/
spectral-mask-resampling/.DS_Store
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/*.json
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/*.csv
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/*.png
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/summary/
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/summary/*.png
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/confusion_matrix_by_observed_size/
!spectral-mask-resampling/outputs/v1_fourier_ambiguity_mask_clean/figures/confusion_matrix_by_observed_size/*.png
